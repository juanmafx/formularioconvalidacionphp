{
    "name": "juanmafx/formularioconvalidacionphp",
    "description": "Secure PHP contact form with encrypted storage and a TOTP-protected admin area.",
    "type": "project",
    "version": "2.0.0",
    "require": {
        "php": ">=8.4 <8.6",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-session": "*",
        "ext-sodium": "*",
        "phpmailer/phpmailer": "^7.2",
        "spomky-labs/otphp": "^11.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": { "ContactForm\\": "backend/src/" }
    },
    "autoload-dev": {
        "psr-4": { "ContactForm\\Tests\\": "backend/tests/" }
    },
    "config": {
        "platform": { "php": "8.4.28" },
        "sort-packages": true,
        "allow-plugins": false,
        "secure-http": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    }
}
